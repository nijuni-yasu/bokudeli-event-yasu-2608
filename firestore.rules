rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        // サポートアカウントかを判定する関数
        function isSupport() {
            return request.auth != null &&
                   request.auth.uid in get(/databases/$(database)/documents/configs/global).data.support_user_ids
        }
        // エンタープライズ: ドキュメントの enterprise_id（未設定 = null）
        function docEnterpriseId(data) {
            return data.get('enterprise_id', null);
        }
        // PF イベントの members_visible_min_count（#2289）。enterprise では変更不可
        function eventMembersVisibleMinCountValid() {
            let newHas = 'members_visible_min_count' in request.resource.data;
            let oldHas = resource != null && 'members_visible_min_count' in resource.data;
            let newVal = newHas ? request.resource.data.members_visible_min_count : 0;
            let oldVal = oldHas ? resource.data.members_visible_min_count : 0;
            let unchanged = newHas == oldHas && (!newHas || newVal == oldVal);
            let enterpriseOnWrite = resource == null
                ? docEnterpriseId(request.resource.data) != null
                : docEnterpriseId(resource.data) != null
                    || docEnterpriseId(request.resource.data) != null;
            let validPfValue = !newHas || (newVal is int && newVal >= 1
                && (!('event_max_people' in request.resource.data)
                    || !(request.resource.data.event_max_people is int)
                    || request.resource.data.event_max_people < 1
                    || newVal <= request.resource.data.event_max_people));
            return unchanged || (!enterpriseOnWrite && validPfValue);
        }
        // partner update: 主催者設定の members_visible_min_count は変更不可（#2289 RC-12）
        function eventMembersVisibleMinCountUnchangedForPartner() {
            let newHas = 'members_visible_min_count' in request.resource.data;
            let oldHas = 'members_visible_min_count' in resource.data;
            let newVal = newHas ? request.resource.data.members_visible_min_count : 0;
            let oldVal = oldHas ? resource.data.members_visible_min_count : 0;
            return newHas == oldHas && (!newHas || newVal == oldVal);
        }
        // エンタープライズ: 認証ユーザーの claims とドキュメントの enterprise_id が一致
        function tokenTenantId() {
            let firebaseClaims = request.auth.token.get('firebase', null);
            return firebaseClaims != null ? firebaseClaims.get('tenant', null) : null;
        }
        function isEnterpriseEmployee() {
            return request.auth != null
                && request.auth.token.get('enterprise_id', null) != null
                && request.auth.token.user_type == 'enterprise'
                && tokenTenantId() != null;
        }
        function isEnterpriseTenantFor(enterpriseId) {
            return isEnterpriseEmployee()
                && request.auth.token.enterprise_id == enterpriseId
                && tokenTenantId() == get(/databases/$(database)/documents/enterprises/$(enterpriseId)).data.tenant_id;
        }
        function isSameEnterprise(data) {
            return isEnterpriseEmployee()
                && docEnterpriseId(data) != null
                && docEnterpriseId(data) == request.auth.token.enterprise_id
                && tokenTenantId() == get(/databases/$(database)/documents/enterprises/$(request.auth.token.enterprise_id)).data.tenant_id;
        }
        // マイページ用冗長カウント（Functions の recount のみ更新。RC-56）
        function userProfileCountFields() {
            return [
                'participated_event_count',
                'friend_count',
                'joined_community_count',
                'managed_community_count',
                'ordered_food_count',
                'counts_updated_at',
            ];
        }
        // カウント1フィールドがクライアント update で改ざん・削除されていないか。
        // resource に無いフィールドへの request 側 0 追加は許可（未バックフィル既存ユーザー向け RC-74）。
        // resource にあるフィールドは request にも同一値が必須（deleteField 相当の削除を拒否 RC-78）。
        function userProfileCountFieldUnchanged(field) {
            return (!(field in resource.data)
                    && (!(field in request.resource.data) || request.resource.data.get(field, 0) == 0))
                || (field in resource.data
                    && field in request.resource.data
                    && request.resource.data[field] == resource.data[field]);
        }
        function userProfileCountsUpdatedAtUnchanged() {
            return (!('counts_updated_at' in resource.data) && !('counts_updated_at' in request.resource.data))
                || ('counts_updated_at' in resource.data
                    && 'counts_updated_at' in request.resource.data
                    && request.resource.data.counts_updated_at == resource.data.counts_updated_at);
        }
        function userProfileCountsUnchanged() {
            return userProfileCountFieldUnchanged('participated_event_count')
                && userProfileCountFieldUnchanged('friend_count')
                && userProfileCountFieldUnchanged('joined_community_count')
                && userProfileCountFieldUnchanged('managed_community_count')
                && userProfileCountFieldUnchanged('ordered_food_count')
                && userProfileCountsUpdatedAtUnchanged();
        }
        function userProfileCountsZeroOrAbsentOnCreate() {
            return request.resource.data.get('participated_event_count', 0) == 0
                && request.resource.data.get('friend_count', 0) == 0
                && request.resource.data.get('joined_community_count', 0) == 0
                && request.resource.data.get('managed_community_count', 0) == 0
                && request.resource.data.get('ordered_food_count', 0) == 0
                && !('counts_updated_at' in request.resource.data);
        }
        function userTagElementValid(tags, index) {
            return tags.size() <= index
                || (tags[index] is string
                    && tags[index].size() > 0
                    && tags[index].size() <= 20
                    && tags[index].matches('.*\\S.*'));
        }
        function isValidUserTagsList(tags) {
            return tags is list
                && tags.size() <= 10
                && userTagElementValid(tags, 0)
                && userTagElementValid(tags, 1)
                && userTagElementValid(tags, 2)
                && userTagElementValid(tags, 3)
                && userTagElementValid(tags, 4)
                && userTagElementValid(tags, 5)
                && userTagElementValid(tags, 6)
                && userTagElementValid(tags, 7)
                && userTagElementValid(tags, 8)
                && userTagElementValid(tags, 9);
        }
        function chatRoomDoc(roomId) {
            return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data;
        }
        function isChatRoomMember(roomId) {
            return request.auth != null
                && request.auth.uid in chatRoomDoc(roomId).member_user_ids;
        }
        function isChatRoomWritable(roomId) {
            let room = chatRoomDoc(roomId);
            return request.auth != null
                && request.auth.uid in room.member_user_ids
                && room.is_active == true;
        }
        function isAllowedChatReactionEmoji(emoji) {
            return emoji == '👍'
                || emoji == '❤️'
                || emoji == '😆'
                || emoji == '😭'
                || emoji == '🎉'
                || emoji == '🙏';
        }
        function chatMessageAllowsReaction(roomId, messageId) {
            let message = get(/databases/$(database)/documents/chat_rooms/$(roomId)/messages/$(messageId));
            return message.data.message_type == 'user'
                && !('deleted_at' in message.data);
        }
        function chatMembershipUpdateAllowed() {
            return request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['last_read_at', 'unread_count', 'updated_at'])
                && request.resource.data.last_read_at is timestamp
                && request.resource.data.last_read_at == request.time
                && request.resource.data.unread_count == 0
                && request.resource.data.updated_at == request.time;
        }
        function minimumParticipantsMapsEqual() {
            return resource.data.get('minimum_participants', null)
                == request.resource.data.get('minimum_participants', null);
        }
        function minimumParticipantsJudgmentEvaluatedAtUnchanged() {
            let oldMp = resource.data.get('minimum_participants', null);
            let newMp = request.resource.data.get('minimum_participants', null);
            let oldEval = oldMp == null ? null : oldMp.get('judgment_evaluated_at', null);
            let newEval = newMp == null ? null : newMp.get('judgment_evaluated_at', null);
            return oldEval == newEval;
        }
        function minimumParticipantsEditableEventStatus() {
            return resource.data.event_status.value == 'in_draft'
                || resource.data.event_status.value == 'applying_reservation';
        }
        function resourceMinimumParticipantsAlreadyEvaluated() {
            let oldMp = resource.data.get('minimum_participants', null);
            return oldMp != null && oldMp.get('judgment_evaluated_at', null) != null;
        }
        function eventMinimumParticipantsCreateValid() {
            let newMp = request.resource.data.get('minimum_participants', null);
            let newEval = newMp == null ? null : newMp.get('judgment_evaluated_at', null);
            return newEval == null;
        }
        function eventMinimumParticipantsManagerUpdateValid() {
            return minimumParticipantsJudgmentEvaluatedAtUnchanged()
                && (minimumParticipantsMapsEqual()
                    || (minimumParticipantsEditableEventStatus()
                        && !resourceMinimumParticipantsAlreadyEvaluated()));
        }
        function eventMinimumParticipantsWriteValid() {
            return (resource == null && eventMinimumParticipantsCreateValid())
                || (resource != null && eventMinimumParticipantsManagerUpdateValid());
        }
        function hasValidChatMessageBody() {
            return 'body' in request.resource.data
                && request.resource.data.body is string
                && request.resource.data.body.size() > 0
                && request.resource.data.body.size() <= 2000;
        }
        function hasValidChatMessageAttachments() {
            return 'attachments' in request.resource.data
                && request.resource.data.attachments is list
                && request.resource.data.attachments.size() >= 1
                && request.resource.data.attachments.size() <= 12;
        }
        // 添付の深い検証（MIME / byte_size / 寸法）は Web SDK setDoc と相性が悪いため Firestore では
        // storage_path の prefix のみ検証する。list.map は permission-denied になるため添字参照を使う。
        // MIME・サイズ・寸法は Storage Rules + クライアント（Zod）で担保する。
        // roomId/messageId を正規表現に直接埋め込むと regex injection になるため、
        // string slice 比較で prefix を検証する。
        function chatAttachmentStoragePathPrefix(roomId, messageId) {
            return 'chat_rooms/' + roomId + '/' + messageId + '/';
        }
        function isValidChatAttachmentAt(prefix, index) {
            let attachment = request.resource.data.attachments[index];
            let path = attachment.storage_path;
            let pSize = prefix.size();
            // prefix が一致し、かつ残りのファイル名部分が 1 文字以上でスラッシュを含まないことを確認
            return path is string
                && path.size() > pSize
                && path[0:pSize] == prefix
                && path[pSize:path.size()].matches('[^/]+');
        }
        function isValidChatAttachmentPath(roomId, messageId) {
            let prefix = chatAttachmentStoragePathPrefix(roomId, messageId);
            let n = request.resource.data.attachments.size();
            return n >= 1 && isValidChatAttachmentAt(prefix, 0)
                && (n < 2 || isValidChatAttachmentAt(prefix, 1))
                && (n < 3 || isValidChatAttachmentAt(prefix, 2))
                && (n < 4 || isValidChatAttachmentAt(prefix, 3))
                && (n < 5 || isValidChatAttachmentAt(prefix, 4))
                && (n < 6 || isValidChatAttachmentAt(prefix, 5))
                && (n < 7 || isValidChatAttachmentAt(prefix, 6))
                && (n < 8 || isValidChatAttachmentAt(prefix, 7))
                && (n < 9 || isValidChatAttachmentAt(prefix, 8))
                && (n < 10 || isValidChatAttachmentAt(prefix, 9))
                && (n < 11 || isValidChatAttachmentAt(prefix, 10))
                && (n < 12 || isValidChatAttachmentAt(prefix, 11));
        }
        match /assets/{asset} {
            allow read: if true
        }
        match /configs/{config} {
            allow read: if true
            // 将来的には isSupport() にする可能性もあるが、現状 functions のみ変更可能とする
            allow write: if false
        }
        match /partners/{partner_id} {
            allow read: if true
            match /shops/{shop} {
                allow read: if true
                // 店舗情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
                // サポートアカウントであれば、運営マネージャーから店舗の開店設定と承認設定を変更できる
                allow create, update, delete: if isSupport()
            }
            match /menus/{menu} {
                allow read: if true
                // メニュー情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
            match /options/{option} {
                allow read: if true
                // メニュー情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
        }
        match /communities/{community} {
            // コミュマネかを判定する関数
            function isManager() {
                return request.auth != null &&
                       exists(/databases/$(database)/documents/communities/$(community)/members/$(request.auth.uid)) &&
                       "manager" in get(/databases/$(database)/documents/communities/$(community)/members/$(request.auth.uid)).data.roles
            }
            // PF: enterprise_id 欠落/null のみ create 可。Enterprise: isSameEnterprise（tenant 含む）
            function canCreateCommunity() {
                return request.auth != null
                    && (
                        (request.auth.token.get('enterprise_id', null) == null
                         && docEnterpriseId(request.resource.data) == null)
                        || isSameEnterprise(request.resource.data)
                    );
            }
            function communityEnterpriseIdUnchanged() {
                return docEnterpriseId(request.resource.data) == docEnterpriseId(resource.data);
            }
            allow read: if docEnterpriseId(resource.data) == null
                        || isSameEnterprise(resource.data);
            // コミュニティはログインユーザーなら申請可能（enterprise_id は canCreateCommunity で検証）
            allow create: if canCreateCommunity()
            // コミュマネ or サポートアカウントであれば、運営マネージャーから店舗の開店設定と承認設定を変更できる
            allow update: if (isSupport() || isManager()) && communityEnterpriseIdUnchanged()
            match /events/{event} {
                allow read: if docEnterpriseId(resource.data) == null
                            || isSameEnterprise(resource.data);
                // コミュマネ or サポートアカウントはイベントの作成・更新ができる
                allow create, update: if isSupport() && eventMinimumParticipantsWriteValid()
                                    && eventMembersVisibleMinCountValid()
                allow create, update: if isManager() && get(/databases/$(database)/documents/communities/$(community)).data.is_approved
                                    && eventMinimumParticipantsWriteValid()
                                    && eventMembersVisibleMinCountValid()
                // コミュマネは下書きイベントの削除ができる
                allow delete: if isManager() && get(/databases/$(database)/documents/communities/$(community)/events/$(event)).data.event_status.value == 'in_draft'
                // 予約承認・予約却下などイベントステータスを店舗が変更できる
                allow update: if request.auth != null && resource.data.partner_id == request.auth.uid
                            && minimumParticipantsMapsEqual()
                            && eventMembersVisibleMinCountUnchangedForPartner()
                match /system/{docId} {
                    allow read, write: if false;
                }
                // 旧 orders（移行完了後に削除）
                match /orders/{order} {
                    allow read, write: if false
                }
                // 新 members / member_orders（EventMemberOrder）
                match /members/{memberId} {
                    allow read: if docEnterpriseId(resource.data) == null
                                || (request.auth != null && (
                                     isSameEnterprise(resource.data)
                                     || request.auth.uid == memberId
                                     || request.auth.uid == resource.data.user_id
                                   ));
                    allow write: if false
                    match /member_orders/{orderId} {
                        allow read: if docEnterpriseId(resource.data) == null
                                    || (request.auth != null && (
                                         isSameEnterprise(resource.data)
                                         || request.auth.uid == resource.data.user_id
                                       ));
                        allow write: if false
                    }
                }
                // stripes（決済情報は本人のみ read 可能 + テナント分離）
                match /stripes/{stripeId} {
                    allow read: if request.auth != null
                                && request.auth.uid == resource.data.user_id
                                && (docEnterpriseId(resource.data) == null || isSameEnterprise(resource.data));
                    allow write: if false
                }
                match /menus/{menuId} {
                    allow read: if true
                }
            }
            match /members/{memberId} {
                allow read: if true
                allow create: if isSupport() || isManager() || (request.auth != null && request.auth.uid == memberId)
                allow update: if isSupport() || isManager()
                allow delete: if request.auth != null && request.auth.uid == memberId
            }
            // invites は functions 内からのみアクセス可能
            match /invites/{document=**} {
                allow read, write: if false
            }
            match /letters/{letter} {
                allow read, write: if isManager() || isSupport()
            }
            match /album_items/{albumItemId} {
                // 公開・非公開にかかわらず誰でも閲覧可（コミュニティページのアルバム表示）
                allow read: if true
                // アップロード・編集・削除はコミュマネまたはサポート
                allow create, update, delete: if isManager() || isSupport();
            }
        }
        match /users/{user_id} {
            allow read: if true
            // ユーザー情報はログインユーザーでないと create/update/deleteできない
            allow create: if request.auth != null
                && request.auth.uid == user_id
                && userProfileCountsZeroOrAbsentOnCreate()
                && (!('user_tags' in request.resource.data)
                    || isValidUserTagsList(request.resource.data.user_tags))
            allow update: if request.auth != null
                && request.auth.uid == user_id
                && userProfileCountsUnchanged()
                && (!('user_tags' in request.resource.data)
                    || isValidUserTagsList(request.resource.data.user_tags))
            match /chat_memberships/{roomId} {
                allow read: if request.auth != null && request.auth.uid == user_id;
                allow create, delete: if false;
                allow update: if request.auth != null
                              && request.auth.uid == user_id
                              && chatMembershipUpdateAllowed();
            }
            match /friends/{friendUserId} {
                allow read: if request.auth != null && request.auth.uid == user_id;
                allow write: if false;
            }
        }
        match /chat_rooms/{roomId} {
            allow read: if isChatRoomMember(roomId);
            allow create, update, delete: if false;

            match /messages/{messageId} {
                allow read: if isChatRoomMember(roomId);
                allow create: if isChatRoomWritable(roomId)
                              && request.resource.data.keys().hasOnly([
                                   'message_type', 'sender_user_id', 'body', 'attachments', 'created_at'
                                 ])
                              && request.resource.data.message_type == 'user'
                              && request.resource.data.sender_user_id == request.auth.uid
                              && request.resource.data.created_at == request.time
                              && (hasValidChatMessageBody() || hasValidChatMessageAttachments())
                              && (!('attachments' in request.resource.data) || isValidChatAttachmentPath(roomId, messageId));
                allow update, delete: if false;

                match /reactions/{userId} {
                    allow read: if isChatRoomMember(roomId);
                    allow create: if isChatRoomWritable(roomId)
                                  && chatMessageAllowsReaction(roomId, messageId)
                                  && request.auth.uid == userId
                                  && request.resource.data.keys().hasOnly(['emoji', 'created_at', 'updated_at'])
                                  && isAllowedChatReactionEmoji(request.resource.data.emoji)
                                  && request.resource.data.created_at == request.time
                                  && request.resource.data.updated_at == request.time;
                    allow update: if isChatRoomWritable(roomId)
                                  && chatMessageAllowsReaction(roomId, messageId)
                                  && request.auth.uid == userId
                                  && request.resource.data.keys().hasOnly(['emoji', 'created_at', 'updated_at'])
                                  && isAllowedChatReactionEmoji(request.resource.data.emoji)
                                  && request.resource.data.created_at == resource.data.created_at
                                  && request.resource.data.updated_at == request.time;
                    allow delete: if isChatRoomWritable(roomId)
                                  && chatMessageAllowsReaction(roomId, messageId)
                                  && request.auth.uid == userId;
                }
            }
        }
        match /users_personal_information/{user_id} {
            // 個人情報はログインユーザーでないと read できない
            allow read: if request.auth != null && request.auth.uid == user_id
            // write は functions からのみ
            allow write: if false
        }
        match /pass_code/{document=**} {
            // pass_code は functions 内からのみアクセス可能
            allow read, write: if false
        }
        function isEnterpriseAdminMember(enterpriseId) {
            return isEnterpriseTenantFor(enterpriseId)
                && exists(/databases/$(database)/documents/enterprises/$(enterpriseId)/members/$(request.auth.uid))
                && get(/databases/$(database)/documents/enterprises/$(enterpriseId)/members/$(request.auth.uid)).data.role == 'admin'
                && get(/databases/$(database)/documents/enterprises/$(enterpriseId)/members/$(request.auth.uid)).data.is_active == true;
        }
        match /enterprises/{enterpriseId} {
            allow read: if isEnterpriseTenantFor(enterpriseId);
            allow write: if false;
            match /members/{userId} {
                allow read: if isEnterpriseTenantFor(enterpriseId);
                allow write: if false;
            }
            match /audit_logs/{logId} {
                allow read: if isEnterpriseAdminMember(enterpriseId);
                allow write: if false;
            }
            match /billing_snapshots/{yearMonth} {
                allow read: if isEnterpriseAdminMember(enterpriseId);
                allow write: if false;
            }
            match /invoice_files/{yearMonth} {
                allow read: if isEnterpriseAdminMember(enterpriseId);
                allow write: if false;
            }
        }
        // collection group query 用ルール（/{path=**} 配下にネスト。フラットな /{path=**}/member_orders は評価されない）
        match /{path=**} {
            match /events/{event} {
                allow read: if docEnterpriseId(resource.data) == null
                            || isSameEnterprise(resource.data);
            }
            match /member_orders/{order} {
                // collectionGroup はネスト path とは別評価。read 条件はネスト側 member_orders と同一（#2278: PF は未認証 CG も可）
                // PF（enterprise_id == null）は doc 全体が未認証 read 可（menu 名に加え stripe_id / processing_payment_intent 等も含む）。
                // 機微情報を member_orders に追加しないこと。公開範囲の見直しは #2282。
                allow read: if docEnterpriseId(resource.data) == null
                            || (request.auth != null && (
                                 isSameEnterprise(resource.data)
                                 || request.auth.uid == resource.data.user_id
                               ));
            }
            match /stripes/{stripeId} {
                allow read: if request.auth != null
                            && request.auth.uid == resource.data.user_id
                            && (docEnterpriseId(resource.data) == null || isSameEnterprise(resource.data));
            }
        }
        match /{path=**}/shops/{shop} {
            allow read: if true
        }
    }
}

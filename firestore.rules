rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        match /partners/{partner_id} {
            match /shops/{shop} {
                // 店舗情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
            match /menus/{menu} {
                // メニュー情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
            match /options/{option} {
                // メニュー情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
        }
        match /communities/{community} {
            // コミュマネかを判定する関数
            function isManager() {
                return request.auth != null && exists(/databases/$(database)/documents/communities/$(community)/managers/$(request.auth.uid));
            }
            allow update: if isManager();
            // support@nijuni.jpのアカウントは全て更新可。本番環境と開発環境のuser_idが異なるので両方設定
            allow update: if request.auth.uid == '3QotPSenRqVPCZnT82fGCLh5EmG3' || request.auth.uid == 'yHOr7eaWWYPHLjPx3H0gZ5nfyWJ2'
            match /events/{event} {
                // コミュマネorサポートアカウントはイベントの作成・更新ができる
                allow create, update: if isManager();
                allow create, update: if request.auth.uid == '3QotPSenRqVPCZnT82fGCLh5EmG3' || request.auth.uid == 'yHOr7eaWWYPHLjPx3H0gZ5nfyWJ2'
                match /orders/{order} {
                    allow create, update, delete: if request.auth != null
                }
            }
            match /members/{member} {
                allow create, update: if request.auth != null && request.auth.uid == request.resource.data.user_id
            }
            // TODO：コミュマネの招待機能。現状はconsoleからのみ作成可能
            // match /managers/{manager} {
                // allow create, update: if request.auth != null && request.auth.uid == request.resource.data.user_id
            // }
        }
        match /users/{user_id} {
            // ユーザー情報はログインユーザーでないと create/update/deleteできない
            allow create, update: if request.auth != null && request.auth.uid == user_id
        }
        match /{document=**} {
            allow read: if true
        }
    }
}
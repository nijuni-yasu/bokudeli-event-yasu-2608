rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        // サポートアカウントかを判定する関数
        function isSupport() {
            return request.auth != null &&
                   request.auth.uid in get(/databases/$(database)/documents/configs/global).data.support_user_ids
        }
        // エンタープライズ: ドキュメントの enterprise_id（未設定 = null）
        function docEnterpriseId(data) {
            return data.get('enterprise_id', null);
        }
        // エンタープライズ: 認証ユーザーの claims とドキュメントの enterprise_id が一致
        function isSameEnterprise(data) {
            return request.auth != null
                && request.auth.token.get('enterprise_id', null) != null
                && docEnterpriseId(data) == request.auth.token.enterprise_id;
        }
        // マイページ用冗長カウント（Functions の recount のみ更新。RC-56）
        function userProfileCountFields() {
            return [
                'participated_event_count',
                'friend_count',
                'joined_community_count',
                'managed_community_count',
                'ordered_food_count',
                'counts_updated_at',
            ];
        }
        // カウント1フィールドがクライアント update で改ざん・削除されていないか。
        // resource に無いフィールドへの request 側 0 追加は許可（未バックフィル既存ユーザー向け RC-74）。
        // resource にあるフィールドは request にも同一値が必須（deleteField 相当の削除を拒否 RC-78）。
        function userProfileCountFieldUnchanged(field) {
            return (!(field in resource.data)
                    && (!(field in request.resource.data) || request.resource.data.get(field, 0) == 0))
                || (field in resource.data
                    && field in request.resource.data
                    && request.resource.data[field] == resource.data[field]);
        }
        function userProfileCountsUpdatedAtUnchanged() {
            return (!('counts_updated_at' in resource.data) && !('counts_updated_at' in request.resource.data))
                || ('counts_updated_at' in resource.data
                    && 'counts_updated_at' in request.resource.data
                    && request.resource.data.counts_updated_at == resource.data.counts_updated_at);
        }
        function userProfileCountsUnchanged() {
            return userProfileCountFieldUnchanged('participated_event_count')
                && userProfileCountFieldUnchanged('friend_count')
                && userProfileCountFieldUnchanged('joined_community_count')
                && userProfileCountFieldUnchanged('managed_community_count')
                && userProfileCountFieldUnchanged('ordered_food_count')
                && userProfileCountsUpdatedAtUnchanged();
        }
        function userProfileCountsZeroOrAbsentOnCreate() {
            return request.resource.data.get('participated_event_count', 0) == 0
                && request.resource.data.get('friend_count', 0) == 0
                && request.resource.data.get('joined_community_count', 0) == 0
                && request.resource.data.get('managed_community_count', 0) == 0
                && request.resource.data.get('ordered_food_count', 0) == 0
                && !('counts_updated_at' in request.resource.data);
        }
        match /assets/{asset} {
            allow read: if true
        }
        match /configs/{config} {
            allow read: if true
            // 将来的には isSupport() にする可能性もあるが、現状 functions のみ変更可能とする
            allow write: if false
        }
        match /partners/{partner_id} {
            allow read: if true
            match /shops/{shop} {
                allow read: if true
                // 店舗情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
                // サポートアカウントであれば、運営マネージャーから店舗の開店設定と承認設定を変更できる
                allow create, update, delete: if isSupport()
            }
            match /menus/{menu} {
                allow read: if true
                // メニュー情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
            match /options/{option} {
                allow read: if true
                // メニュー情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
        }
        match /communities/{community} {
            // コミュマネかを判定する関数
            function isManager() {
                return request.auth != null &&
                       exists(/databases/$(database)/documents/communities/$(community)/members/$(request.auth.uid)) &&
                       "manager" in get(/databases/$(database)/documents/communities/$(community)/members/$(request.auth.uid)).data.roles
            }
            allow read: if docEnterpriseId(resource.data) == null
                        || isSameEnterprise(resource.data);
            // コミュニティはログインユーザーなら申請可能
            allow create: if request.auth != null
            // コミュマネ or サポートアカウントであれば、運営マネージャーから店舗の開店設定と承認設定を変更できる
            allow update: if isSupport() || isManager()
            match /events/{event} {
                allow read: if docEnterpriseId(resource.data) == null
                            || isSameEnterprise(resource.data);
                // コミュマネ or サポートアカウントはイベントの作成・更新ができる
                allow create, update: if isSupport()
                allow create, update: if isManager() && get(/databases/$(database)/documents/communities/$(community)).data.is_approved
                // コミュマネは下書きイベントの削除ができる
                allow delete: if isManager() && get(/databases/$(database)/documents/communities/$(community)/events/$(event)).data.event_status.value == 'in_draft'
                // 予約承認・予約却下などイベントステータスを店舗が変更できる
                allow update: if request.auth != null && resource.data.partner_id == request.auth.uid
                // 旧 orders（移行完了後に削除）
                match /orders/{order} {
                    allow read, write: if false
                }
                // 新 members / member_orders（EventMemberOrder）
                match /members/{memberId} {
                    allow read: if docEnterpriseId(resource.data) == null
                                || (request.auth != null && (
                                     isSameEnterprise(resource.data)
                                     || request.auth.uid == memberId
                                     || request.auth.uid == resource.data.user_id
                                   ));
                    allow write: if false
                    match /member_orders/{orderId} {
                        allow read: if docEnterpriseId(resource.data) == null
                                    || (request.auth != null && (
                                         isSameEnterprise(resource.data)
                                         || request.auth.uid == resource.data.user_id
                                       ));
                        allow write: if false
                    }
                }
                // stripes（決済情報は本人のみ read 可能 + テナント分離）
                match /stripes/{stripeId} {
                    allow read: if request.auth != null
                                && request.auth.uid == resource.data.user_id
                                && (docEnterpriseId(resource.data) == null || isSameEnterprise(resource.data));
                    allow write: if false
                }
                match /menus/{menuId} {
                    allow read: if true
                }
            }
            match /members/{memberId} {
                allow read: if true
                allow create: if isSupport() || isManager() || (request.auth != null && request.auth.uid == memberId)
                allow update: if isSupport() || isManager()
                allow delete: if request.auth != null && request.auth.uid == memberId
            }
            // invites は functions 内からのみアクセス可能
            match /invites/{document=**} {
                allow read, write: if false
            }
            match /letters/{letter} {
                allow read, write: if isManager()
            }
            match /album_items/{albumItemId} {
                // 公開・非公開にかかわらず誰でも閲覧可（コミュニティページのアルバム表示）
                allow read: if true
                // アップロード・編集・削除はコミュマネまたはサポート
                allow create, update, delete: if isManager() || isSupport();
            }
        }
        match /users/{user_id} {
            allow read: if true
            // ユーザー情報はログインユーザーでないと create/update/deleteできない
            allow create: if request.auth != null
                && request.auth.uid == user_id
                && userProfileCountsZeroOrAbsentOnCreate()
            allow update: if request.auth != null
                && request.auth.uid == user_id
                && userProfileCountsUnchanged()
            match /friends/{friend_user_id} {
                allow read, write: if false
            }
        }
        match /users_personal_information/{user_id} {
            // 個人情報はログインユーザーでないと read できない
            allow read: if request.auth != null && request.auth.uid == user_id
            // write は functions からのみ
            allow write: if false
        }
        match /pass_code/{document=**} {
            // pass_code は functions 内からのみアクセス可能
            allow read, write: if false
        }
        function isEnterpriseAdminMember(enterpriseId) {
            return request.auth != null
                && request.auth.token.enterprise_id == enterpriseId
                && exists(/databases/$(database)/documents/enterprises/$(enterpriseId)/members/$(request.auth.uid))
                && get(/databases/$(database)/documents/enterprises/$(enterpriseId)/members/$(request.auth.uid)).data.role == 'admin'
                && get(/databases/$(database)/documents/enterprises/$(enterpriseId)/members/$(request.auth.uid)).data.is_active == true;
        }
        match /enterprises/{enterpriseId} {
            allow read: if request.auth != null
                        && request.auth.token.enterprise_id == enterpriseId;
            allow write: if false;
            match /members/{userId} {
                allow read: if request.auth != null
                            && request.auth.token.enterprise_id == enterpriseId;
                allow write: if false;
            }
            match /audit_logs/{logId} {
                allow read: if isEnterpriseAdminMember(enterpriseId);
                allow write: if false;
            }
            match /billing_snapshots/{yearMonth} {
                allow read: if isEnterpriseAdminMember(enterpriseId);
                allow write: if false;
            }
        }
        // collection group query 用ルール
        match /{path=**}/events/{event} {
            allow read: if docEnterpriseId(resource.data) == null
                        || isSameEnterprise(resource.data);
        }
        match /{path=**}/member_orders/{order} {
            allow read: if docEnterpriseId(resource.data) == null
                        || (request.auth != null && (
                             isSameEnterprise(resource.data)
                             || request.auth.uid == resource.data.user_id
                           ));
        }
        match /{path=**}/stripes/{stripeId} {
            allow read: if request.auth != null
                        && request.auth.uid == resource.data.user_id
                        && (docEnterpriseId(resource.data) == null || isSameEnterprise(resource.data));
        }
        match /{path=**}/shops/{shop} {
            allow read: if true
        }
    }
}

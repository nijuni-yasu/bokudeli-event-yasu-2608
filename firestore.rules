rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {
        match /partners/{partner_id} {
            match /shops/{shop} {
                // 店舗情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
                // support+admin@nijuni.jp アカウントであれば、運営マネージャーから店舗の開店設定と承認設定を変更できる
                allow create, update, delete: if request.auth.uid == 'B8xjaF1ftWWr3bCQpmPzmxJ9uQt2' || request.auth.uid == '5XjlhVfryCYErPmMIJ1YX6xEzC62'
            }
            match /menus/{menu} {
                // メニュー情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
            match /options/{option} {
                // メニュー情報はログインした店舗アカウントでないと create/update/deleteできない
                allow create, update, delete: if request.auth != null && request.auth.uid == partner_id
            }
        }
        match /communities/{community} {
            // コミュニティはログインユーザーなら申請可能
            allow create: if request.auth != null
            // コミュマネかを判定する関数
            function isManager() {
                return request.auth != null &&
                       exists(/databases/$(database)/documents/communities/$(community)/members/$(request.auth.uid)) &&
                       "manager" in get(/databases/$(database)/documents/communities/$(community)/members/$(request.auth.uid)).data.roles ;
            }
            allow update: if isManager();
            // support@nijuni.jpのアカウントは全て更新可。本番環境と開発環境のuser_idが異なるので両方設定
            allow update: if request.auth.uid == '3QotPSenRqVPCZnT82fGCLh5EmG3' || request.auth.uid == 'yHOr7eaWWYPHLjPx3H0gZ5nfyWJ2'
            match /events/{event} {
                // コミュマネorサポートアカウントはイベントの作成・更新ができる
                allow create, update: if isManager() && get(/databases/$(database)/documents/communities/$(community)).data.is_approved;
                allow create, update: if request.auth.uid == '3QotPSenRqVPCZnT82fGCLh5EmG3' || request.auth.uid == 'yHOr7eaWWYPHLjPx3H0gZ5nfyWJ2'
                // 予約承認・予約却下などイベントステータスを店舗が変更できる
                allow update: if request.auth != null && resource.data.partner_id == request.auth.uid
                match /orders/{order} {
                    allow create, update, delete: if request.auth != null
                }
            }
            match /members/{member} {
                allow create, update: if request.auth != null && request.auth.uid == request.resource.id
            }
            // invites は functions 内からのみアクセス可能
            match /invites/{document=**} {
                allow read, write: if false
            }
        }
        match /users/{user_id} {
            // ユーザー情報はログインユーザーでないと create/update/deleteできない
            allow create, update: if request.auth != null && request.auth.uid == user_id
        }
        match /{document=**} {
            allow read: if true
        }
    }
}
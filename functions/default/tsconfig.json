{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "paths": {
      "@shokujii/common/*": ["../../common/dist/*"]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../common"
    }
  ]
}

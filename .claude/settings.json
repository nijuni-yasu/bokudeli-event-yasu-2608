{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git -C * status*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v*)",
      "Bash(git remote show*)",
      "Bash(git remote get-url*)",
      "Bash(git stash *)",
      "Bash(git fetch:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git config --get:*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash *)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create *)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api:*)",
      "Bash(firebase projects:list)",
      "Bash(firebase functions:list)",
      "Bash(firebase emulators:start:*)",
      "Bash(firebase emulators:exec:*)",
      "Bash(npm run *)",
      "Bash(npm -w * run test)",
      "Bash(npm -w * run test:*)",
      "Bash(npm -w * run lint)",
      "Bash(npm -w * run format)",
      "Bash(npm -w * run format:check)",
      "Bash(npm -w * run build)",
      "Bash(npm -w * run build:*)",
      "Bash(npx vue-tsc *)",
      "Bash(npx prettier *)",
      "Bash(python3 -m json.tool *)",
      "Bash(python3 .agents/scripts/*)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Edit(/.claude/skills/shokujii-code-review/**)"
    ],
    "deny": [
      "Bash(git push origin development*)",
      "Bash(git push origin main*)",
      "Bash(git push origin production*)",
      "Bash(git push * HEAD:development)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * HEAD:production)",
      "Bash(git push * :development)",
      "Bash(git push * :main)",
      "Bash(git push * :production)",
      "Bash(git push * :refs/heads/development)",
      "Bash(git push * :refs/heads/main)",
      "Bash(git push * :refs/heads/production)",
      "Bash(git push * *:development)",
      "Bash(git push * *:main)",
      "Bash(git push * *:production)",
      "Bash(git push * *:refs/heads/development)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push * *:refs/heads/production)",
      "Bash(git push * HEAD:refs/heads/development)",
      "Bash(git push * HEAD:refs/heads/main)",
      "Bash(git push * HEAD:refs/heads/production)",
      "Bash(git push * refs/heads/development)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * refs/heads/production)",
      "Bash(git commit -a*)",
      "Bash(git commit * -a *)",
      "Bash(git commit --all*)",
      "Bash(git commit * --all *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(git remote rename *)",
      "Bash(cat .env*)",
      "Bash(cat .secret*)",
      "Bash(cat */.env*)",
      "Bash(cat */.secret*)",
      "Bash(cat * .env*)",
      "Bash(cat * .secret*)",
      "Bash(cat * */.env*)",
      "Bash(cat * */.secret*)",
      "Bash(cat *.pem)",
      "Bash(cat * *.pem)",
      "Bash(cat */*.pem)",
      "Bash(cat * .key)",
      "Bash(cat */*.key)",
      "Bash(head .env*)",
      "Bash(head .secret*)",
      "Bash(head */.env*)",
      "Bash(head */.secret*)",
      "Bash(head * .env*)",
      "Bash(head * .secret*)",
      "Bash(head * */.env*)",
      "Bash(head * */.secret*)",
      "Bash(head *.pem)",
      "Bash(head * *.pem)",
      "Bash(head */*.pem)",
      "Bash(head * .key)",
      "Bash(head */*.key)",
      "Bash(tail .env*)",
      "Bash(tail .secret*)",
      "Bash(tail */.env*)",
      "Bash(tail */.secret*)",
      "Bash(tail * .env*)",
      "Bash(tail * .secret*)",
      "Bash(tail * */.env*)",
      "Bash(tail * */.secret*)",
      "Bash(tail *.pem)",
      "Bash(tail * *.pem)",
      "Bash(tail */*.pem)",
      "Bash(tail * .key)",
      "Bash(tail */*.key)",
      "Bash(grep */.env*)",
      "Bash(grep */.secret*)",
      "Bash(grep * .env*)",
      "Bash(grep * .secret*)",
      "Bash(grep * */.env*)",
      "Bash(grep * */.secret*)",
      "Bash(grep *.pem)",
      "Bash(grep * *.pem)",
      "Bash(grep */*.pem)",
      "Bash(grep * .key)",
      "Bash(grep */*.key)",
      "Bash(awk */.env*)",
      "Bash(awk */.secret*)",
      "Bash(awk * .env*)",
      "Bash(awk * .secret*)",
      "Bash(awk * */.env*)",
      "Bash(awk * */.secret*)",
      "Bash(awk *.pem)",
      "Bash(awk * *.pem)",
      "Bash(awk */*.pem)",
      "Bash(awk * .key)",
      "Bash(awk */*.key)",
      "Bash(sort .env*)",
      "Bash(sort .secret*)",
      "Bash(sort */.env*)",
      "Bash(sort */.secret*)",
      "Bash(sort * .env*)",
      "Bash(sort * .secret*)",
      "Bash(sort * */.env*)",
      "Bash(sort * */.secret*)",
      "Bash(sort *.pem)",
      "Bash(sort * *.pem)",
      "Bash(sort */*.pem)",
      "Bash(sort * .key)",
      "Bash(sort */*.key)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git checkout -- *)",
      "Bash(git restore .*)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r*)",
      "Bash(rm --recursive*)",
      "Bash(find * -delete*)",
      "Bash(firebase deploy*)",
      "Bash(firebase firestore:delete*)",
      "Bash(firebase functions:delete*)",
      "Bash(firebase projects:delete*)",
      "Bash(firebase hosting:disable*)",
      "Bash(firebase database:remove*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(yarn*)",
      "Bash(npm version *)",
      "Bash(git branch -f main*)",
      "Bash(git branch -f production*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-usage-task-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"",
            "statusMessage": "保護ファイルチェック中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-git-release.sh\"",
            "statusMessage": "リリース系 git チェック中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-usage-posttool-bash.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-usage-session-end.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-usage-turn-record.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-and-format.sh\"",
            "timeout": 120,
            "statusMessage": "lint & format チェック中..."
          }
        ]
      }
    ]
  }
}

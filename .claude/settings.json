{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git stash *)",
      "Bash(git fetch:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git config --get:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api:*)",
      "Bash(firebase projects:list)",
      "Bash(firebase functions:list)",
      "Bash(firebase emulators:start:*)",
      "Bash(firebase emulators:exec:*)",
      "Bash(npm -w * run test)",
      "Bash(npm -w * run test:*)",
      "Bash(npm -w * run lint)",
      "Bash(npm -w * run format)",
      "Bash(npm -w * run format:check)",
      "Bash(npm -w * run build)",
      "Bash(npm -w * run build:*)",
      "Bash(npm -w base run build:types)",
      "Bash(npm -w user run build:types)",
      "Bash(npm -w partner run build:types)",
      "Bash(git remote *)",
      "Bash(GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash *)",
      "Bash(python3 -m json.tool *)",
      "Bash(npm -w common test *)",
      "Bash(npx vue-tsc *)",
      "Bash(npm -w enterprise run build:types)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git checkout -- *)",
      "Bash(git restore .*)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r*)",
      "Bash(rm --recursive*)",
      "Bash(find * -delete*)",
      "Bash(firebase deploy*)",
      "Bash(firebase firestore:delete*)",
      "Bash(firebase functions:delete*)",
      "Bash(firebase projects:delete*)",
      "Bash(firebase hosting:disable*)",
      "Bash(firebase database:remove*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(yarn*)",
      "Bash(npm version *)",
      "Bash(git branch -f main*)",
      "Bash(git branch -f production*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-usage-task-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"",
            "statusMessage": "保護ファイルチェック中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-git-release.sh\"",
            "statusMessage": "リリース系 git チェック中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-usage-posttool-bash.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-usage-session-end.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-usage-turn-record.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-and-format.sh\"",
            "timeout": 120,
            "statusMessage": "lint & format チェック中..."
          }
        ]
      }
    ]
  }
}

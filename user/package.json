    "eslint-plugin-promise": "^6.0.1",
    "eslint-plugin-sonarjs": "^0.19.0",
    "eslint-plugin-unicorn": "^46.0.0",
    "eslint-plugin-vue": "^9.10.0",
    "firebase-tools": "^12.0.0",
    "postcss-html": "^1.5.0",

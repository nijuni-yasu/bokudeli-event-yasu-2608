    "firebase": "^9.19.1",
    "jwt-decode": "^3.1.2",
    "pinia": "2.0.36",
    "postcss": "^8",
    "postcss-sorting": "^8.0.2",
    "prismjs": "^1.29.0",
    "sass": "^1.56.1",
    "stylelint-order": "^6.0.3",
    "vue": "3.2.47",

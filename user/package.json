{
  "name": "materio-vuejs-admin-template",
  "version": "2.1.1",
  "private": true,
  "scripts": {
    "dev-development": "npm run build:icons && vite --host -m development",
    "dev-production": "npm run build:icons && vite --host -m production",
    "build-development": "npm run build:icons && vite build -m development",
    "build-production": "npm run build:icons && vite build -m production",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/ -c .eslintrc.js --fix --rulesdir eslint-internal-rules/ --ext .ts,.js,.vue,.tsx,.jsx",
    "build:icons": "tsc -b src/@iconify && node src/@iconify/build-icons.js",
    "prettier": "prettier -w .",
    "deploy-development": "firebase use development && firebase deploy --only hosting:user",
    "deploy-production": "firebase use production && firebase deploy --only hosting:user"
  },
  "dependencies": {
    "@casl/ability": "^6.2.0",
    "@casl/vue": "^2.2.0",
    "@floating-ui/dom": "^1.2.7",
    "@mdi/font": "^7.0.96",
    "@vueuse/core": "^10.2.1",
    "@vueuse/integrations": "^10.2.1",
    "@vueuse/math": "^10.1.2",
    "axios": "^1.4.0",
    "axios-mock-adapter": "^1.21.2",
    "date-fns": "^2.30.0",
    "firebase": "^9.19.1",
    "jwt-decode": "^3.1.2",
    "pinia": "2.0.36",
    "pinia-plugin-persistedstate": "^3.1.0",
    "prismjs": "^1.29.0",
    "sass": "^1.63.4",
    "stripe": "^12.17.0",
    "universal-cookie": "^4.0.4",
    "vue": "3.2.47",
    "vue-flatpickr-component": "^11.0.3",
    "vue-i18n": "^9.2.2",
    "vue-prism-component": "^2.0.0",
    "vue-router": "^4.1.5",
    "vue3-perfect-scrollbar": "^1.6.0",
    "vuetify": "^3.0.3",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@antfu/eslint-config-vue": "^0.38.5",
    "@fullcalendar/core": "^6.1.6",
    "@fullcalendar/daygrid": "^6.1.6",
    "@fullcalendar/interaction": "^6.1.6",
    "@fullcalendar/list": "^6.1.6",
    "@fullcalendar/timegrid": "^6.1.6",
    "@fullcalendar/vue3": "^6.1.6",
    "@iconify-json/mdi": "^1.1.35",
    "@iconify/tools": "^2.1.2",
    "@iconify/vue": "^4.1.1",
    "@intlify/unplugin-vue-i18n": "^0.10.0",
    "@types/lodash": "^4.14.198",
    "@types/node": "^18.7.18",
    "@types/webfontloader": "^1.6.34",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "@vitejs/plugin-vue": "^4.2.1",
    "@vitejs/plugin-vue-jsx": "^3.0.1",
    "eslint": "^8.38.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.5.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-promise": "^6.0.1",
    "eslint-plugin-sonarjs": "^0.19.0",
    "eslint-plugin-unicorn": "^46.0.0",
    "eslint-plugin-vue": "^9.10.0",
    "firebase-tools": "^12.0.0",
    "lodash": "^4.17.21",
    "postcss-html": "^1.5.0",
    "prettier": "^2.8.7",
    "stylelint": "14.15.0",
    "stylelint-config-idiomatic-order": "9.0.0",
    "stylelint-config-standard-scss": "6.1.0",
    "stylelint-use-logical-spec": "4.1.0",
    "type-fest": "^3.2.0",
    "typescript": "^5.0.4",
    "unplugin-auto-import": "^0.15.3",
    "unplugin-vue-components": "^0.24.1",
    "unplugin-vue-define-options": "^1.3.4",
    "vite": "^4.3.4",
    "vite-plugin-pages": "^0.29.0",
    "vite-plugin-vue-layouts": "^0.8.0",
    "vite-plugin-vuetify": "^1.0.2",
    "vue-tsc": "^1.0.9"
  },
  "packageManager": "yarn@1.22.18",
  "resolutions": {
    "postcss": "8"
  }
}

{
  "extends": "../tsconfig.base.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "materio/@core.d.ts",
    "materio/@layouts.d.ts",
    "materio/@themeConfig.d.ts"
  ],
  "exclude": ["node_modules", "materio/@core/**", "materio/@layouts/**"],
  "compilerOptions": {
    "paths": {
      "@shokujii/base/*": ["./src/*"],
      "@layouts/*": ["./materio/@layouts/*"],
      "@layouts": ["./materio/@layouts"],
      "@core/*": ["./materio/@core/*"],
      "@core": ["./materio/@core"]
    }
  }
}

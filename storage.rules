rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // サポートアカウントかを判定する関数
    function isSupport() {
      return request.auth != null &&
             request.auth.uid in firestore.get(/databases/(default)/documents/configs/global).data.support_user_ids
    }

    // コミュニティ管理者かを判定する関数
    function isCommunityManager(communityId) {
      let member = firestore.get(/databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid));
      return request.auth != null &&
             member != null &&
             member.data.roles is list &&
             "manager" in member.data.roles
    }

    // users - ユーザー自身が作成、編集、削除できる、誰でも閲覧できる
    match /users/{userId}/{allPaths=**} {
      allow read: if true
      allow write: if request.auth != null && request.auth.uid == userId
    }

    // communities - コミュニティ管理者またはサポートアカウントが作成、編集、削除できる、誰でも閲覧できる
    match /communities/{communityId}/{allPaths=**} {
      allow read: if true
      allow write: if isCommunityManager(communityId) || isSupport()
    }

    // partners - 店舗管理者が作成、編集、削除できる、誰でも閲覧できる
    match /partners/{partnerId}/{allPaths=**} {
      allow read: if true
      allow write: if request.auth != null && request.auth.uid == partnerId
    }

    // assets - 誰でも閲覧できる
    match /assets/{allPaths=**} {
      allow read: if true
      allow write: if false
    }

    match /enterprises/{enterpriseId}/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.token.enterprise_id == enterpriseId;
      allow write: if false;
    }

    match /enterprises/{enterpriseId}/logo/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.enterprise_id == enterpriseId
                   && request.auth.token.enterprise_role == 'admin'
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|svg\\+xml)');
    }
  }
}

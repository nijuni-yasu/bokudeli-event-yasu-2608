{
  "name": "bokudeli-event-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VUE_DEVTOOLS= vite -m development",
    "dev-development": "vite -m development",
    "dev-production": "vite -m production",
    "build-development": "run-p type-check \"build-only {@}\" -- -m development",
    "build-production": "run-p type-check \"build-only {@}\" -- -m production",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "find src -follow -type f -regextype posix-egrep -not -regex 'src/(@core|@layouts)/.*' \\( -name '*.ts' -o -name '*.vue' \\) | xargs eslint .",
    "format": "find src -follow -type f -regextype posix-egrep -not -regex 'src/(@core|@layouts)/.*' \\( -name '*.ts' -o -name '*.vue' \\) | xargs readlink -f | xargs prettier --write"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.5",
    "@tinymce/tinymce-vue": "^6",
    "@turf/distance": "^7.0.0",
    "@vueuse/core": "^10.11.0",
    "cookie-es": "^1.1.0",
    "date-fns": "^3.6.0",
    "destr": "^2.0.3",
    "firebase": "~10.6.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-flatpickr-component": "^11.0.5",
    "vue-i18n": "^9.13.1",
    "vue-qrious": "^3.1.1",
    "vue-router": "^4.3.0",
    "vue3-perfect-scrollbar": "^1.6.1",
    "vuetify": "^3.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@mdi/js": "^7.4.47",
    "@tsconfig/node20": "^20.1.4",
    "@types/lodash": "^4.17.5",
    "@types/node": "^20.12.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "9.x",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.26.0",
    "globals": "^15.6.0",
    "npm-run-all2": "^6.1.2",
    "prettier": "^3.2.5",
    "sass": "^1.77.4",
    "typescript": "~5.4.0",
    "typescript-eslint": "^7.13.1",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-router": "^0.10.0",
    "vite": "^5.2.8",
    "vite-plugin-vue-devtools": "^7.0.25",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-plugin-vuetify": "^2.0.3",
    "vue-tsc": "2.0.16"
  }
}
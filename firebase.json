{
  "hosting": [
    {
      "public": "admin/dist",
      "target": "admin",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "public": "manager/dist",
      "target": "manager",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "public": "user/dist",
      "target": "user",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/c/**/e/**",
          "function": "handleEventOgpRequest",
          "region": "asia-northeast1"
        },
        {
          "source": "/c/**",
          "function": "handleCommunityOgpRequest",
          "region": "asia-northeast1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "public": "curry/dist",
      "target": "curry",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/c/**/e/**",
          "function": "handleEventOgpRequest",
          "region": "asia-northeast1"
        },
        {
          "source": "/c/**",
          "function": "handleCommunityOgpRequest",
          "region": "asia-northeast1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions/default",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        ".gitignore",
        "src",
        "tsconfig.*",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "source": "functions/legacy",
      "codebase": "legacy",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "functions/shokujii-slackbot",
      "codebase": "shokujii-slackbot",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "source": "functions/shokujii-linebot",
      "codebase": "shokujii-linebot",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
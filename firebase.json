{
  "hosting": [
    {
      "public": "admin/dist",
      "target": "admin",
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "public": "manager/dist",
      "target": "manager",
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "public": "user/dist",
      "target": "user",
      "headers": [
        {
          "source": "/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=3600"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/c/**/e/**",
          "function": "replace_ogp_tags",
          "region": "asia-northeast1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "redirects": [
        {
          "source": "/community/:communityId/events/:eventId",
          "destination": "/c/:communityId/e/:eventId",
          "type": 301
        },
        {
          "source": "/community/:communityId",
          "destination": "/c/:communityId",
          "type": 301
        },
        {
          "source": "/community",
          "destination": "/c",
          "type": 301
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

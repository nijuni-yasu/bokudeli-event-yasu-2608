{
  "hosting": [
    {
      "public": "admin/dist",
      "target": "admin",
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "public": "manager/dist",
      "target": "manager",
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "public": "user/dist",
      "target": "user",
      "rewrites": [
        {
          "source": "/community/**/events/**",
          "function": "replace_ogp_tags",
          "region": "asia-northeast1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "user_old",
      "redirects": [
        {
          "regex": "(.*)",
          "destination": "https://shokujii.jp/:1",
          "type": 301
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
